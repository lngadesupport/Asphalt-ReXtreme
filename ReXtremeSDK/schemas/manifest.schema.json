{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReXtreme Mod Manifest",
  "type": "object",
  "required": ["schema_version", "id", "name", "version", "sdk_api", "type"],
  "properties": {
    "schema_version": { "const": 1 },
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:[._-][a-z0-9]+)+$" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "sdk_api": { "type": "integer", "minimum": 1 },
    "type": { "type": "string" },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "version": { "type": "string" }
        }
      }
    }
  }
}
