{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReXtreme Livery",
  "type": "object",
  "required": ["id", "vehicle", "layers"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "vehicle": { "type": "string" },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["type"],
        "properties": {
          "type": { "enum": ["paint", "gradient", "stripe", "shape", "decal", "logo", "number", "text", "mask", "pattern", "texture"] },
          "source": { "type": ["string", "null"] },
          "opacity": { "type": "number", "minimum": 0, "maximum": 1 },
          "transform": { "type": ["object", "null"] }
        }
      }
    }
  }
}
