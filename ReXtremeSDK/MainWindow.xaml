<Window x:Class="ReXtremeSDK.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ReXtreme SDK" Width="1500" Height="900" MinWidth="1100" MinHeight="700">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="170"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource EditorPanel}" BorderBrush="{StaticResource EditorBorder}" BorderThickness="0,0,0,1">
            <DockPanel Margin="6">
                <StackPanel Orientation="Horizontal" DockPanel.Dock="Left">
                    <Button Content="Novo projeto" Click="NewProject_Click"/>
                    <Button Content="Abrir projeto" Click="OpenProject_Click"/>
                    <Button Content="Validar" Click="Validate_Click"/>
                    <Button Content="Build .rxmod" Click="Build_Click"/>
                    <Button Content="Verificar .rxmod" Click="VerifyPackage_Click"/>
                    <Separator Margin="8,0"/>
                    <Button Content="Importar modelo 3D" Click="ImportModel_Click"/>
                    <Button Content="Importar música" Click="ImportMusic_Click"/>
                </StackPanel>
                <TextBlock x:Name="ProjectPathText" DockPanel.Dock="Right" VerticalAlignment="Center"
                           Foreground="{StaticResource EditorMuted}" Text="Nenhum projeto aberto"/>
            </DockPanel>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="5"/>
                <ColumnDefinition Width="320"/>
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="{StaticResource EditorPanel}" Padding="8">
                <DockPanel>
                    <TextBlock DockPanel.Dock="Top" Text="PROJETO / ASSETS" FontWeight="Bold" Margin="4,2,4,8"/>
                    <TreeView x:Name="ProjectTree" Background="Transparent" Foreground="{StaticResource EditorText}"/>
                </DockPanel>
            </Border>
            <GridSplitter Grid.Column="1" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource EditorBorder}"/>

            <TabControl x:Name="EditorTabs" Grid.Column="2" Background="{StaticResource EditorBackground}">
                <TabItem Header="Viewport">
                    <Grid Background="#111317">
                        <Viewport3D x:Name="ModelViewport" ClipToBounds="True"
                                    MouseDown="Viewport_MouseDown" MouseMove="Viewport_MouseMove" MouseUp="Viewport_MouseUp">
                            <Viewport3D.Camera>
                                <PerspectiveCamera Position="0,1.8,6" LookDirection="0,-0.3,-6" UpDirection="0,1,0" FieldOfView="55"/>
                            </Viewport3D.Camera>
                            <ModelVisual3D>
                                <ModelVisual3D.Content><AmbientLight Color="#707070"/></ModelVisual3D.Content>
                            </ModelVisual3D>
                            <ModelVisual3D>
                                <ModelVisual3D.Content><DirectionalLight Color="White" Direction="-0.5,-1,-0.8"/></ModelVisual3D.Content>
                            </ModelVisual3D>
                            <ModelVisual3D x:Name="PreviewVisual"/>
                        </Viewport3D>
                        <Border VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12" Padding="8,5" Background="#AA000000">
                            <TextBlock x:Name="ViewportHint" Text="Viewport 3D — importe um OBJ para o preview inicial" Foreground="White"/>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="Veículo">
                    <ScrollViewer Background="{StaticResource EditorBackground}">
                        <StackPanel Margin="20" MaxWidth="800" HorizontalAlignment="Left">
                            <TextBlock Text="VEHICLE EDITOR" FontSize="22" FontWeight="Bold" Margin="0,0,0,16"/>
                            <TextBlock Text="ID namespaced"/>
                            <TextBox x:Name="VehicleIdBox" Text="com.author.vehicle.custom" Margin="0,4,0,10" Padding="6"/>
                            <TextBlock Text="Nome"/>
                            <TextBox x:Name="VehicleNameBox" Text="Custom Vehicle" Margin="0,4,0,10" Padding="6"/>
                            <TextBlock Text="Categoria original"/>
                            <ComboBox x:Name="VehicleCategoryBox" Margin="0,4,0,10" SelectedIndex="0">
                                <ComboBoxItem Content="rally"/>
                                <ComboBoxItem Content="monster-truck"/>
                                <ComboBoxItem Content="buggy"/>
                                <ComboBoxItem Content="suv"/>
                                <ComboBoxItem Content="truck"/>
                                <ComboBoxItem Content="muscle"/>
                                <ComboBoxItem Content="pickup"/>
                            </ComboBox>
                            <TextBlock Text="Perfil original de física"/>
                            <TextBox x:Name="VehicleBaseProfileBox" Text="original.profile.pending-extraction" Margin="0,4,0,16" Padding="6"/>

                            <TextBlock Text="DESEMPENHO — barras do jogo" FontWeight="Bold" Margin="0,0,0,8"/>
                            <TextBlock Text="Velocidade"/>
                            <Slider x:Name="SpeedSlider" Minimum="0" Maximum="100" Value="50"/>
                            <TextBlock Text="Aceleração" Margin="0,8,0,0"/>
                            <Slider x:Name="AccelerationSlider" Minimum="0" Maximum="100" Value="50"/>
                            <TextBlock Text="Handling" Margin="0,8,0,0"/>
                            <Slider x:Name="HandlingSlider" Minimum="0" Maximum="100" Value="50"/>
                            <TextBlock Text="Nitro" Margin="0,8,0,0"/>
                            <Slider x:Name="NitroSlider" Minimum="0" Maximum="100" Value="50"/>
                            <TextBlock Text="As barras são a interface. A física real é derivada do perfil original." Foreground="{StaticResource EditorMuted}" Margin="0,8,0,14"/>
                            <Button Content="Criar definição de veículo" Width="220" HorizontalAlignment="Left" Click="CreateVehicle_Click"/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Evento / Carreira">
                    <ScrollViewer Background="{StaticResource EditorBackground}">
                        <StackPanel Margin="20" MaxWidth="900" HorizontalAlignment="Left">
                            <TextBlock Text="EVENT / CAREER EDITOR" FontSize="22" FontWeight="Bold" Margin="0,0,0,14"/>

                            <GroupBox Header="Corrida / Evento" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="ID"/>
                                    <TextBox x:Name="EventIdBox" Text="local.event.new-event" Padding="6" Margin="0,3,0,8"/>
                                    <TextBlock Text="Nome"/>
                                    <TextBox x:Name="EventNameBox" Text="New Event" Padding="6" Margin="0,3,0,8"/>
                                    <TextBlock Text="Pista (ID original ou customizado)"/>
                                    <TextBox x:Name="EventTrackBox" Text="original.track.pending" Padding="6" Margin="0,3,0,8"/>
                                    <WrapPanel>
                                        <StackPanel Width="220" Margin="0,0,12,0">
                                            <TextBlock Text="Modo"/>
                                            <ComboBox x:Name="EventModeBox" SelectedIndex="0" Margin="0,3,0,8">
                                                <ComboBoxItem Content="classic"/>
                                                <ComboBoxItem Content="elimination"/>
                                                <ComboBoxItem Content="infected"/>
                                                <ComboBoxItem Content="knockdown"/>
                                                <ComboBoxItem Content="time-attack"/>
                                                <ComboBoxItem Content="checkpoint"/>
                                                <ComboBoxItem Content="survival"/>
                                                <ComboBoxItem Content="custom"/>
                                            </ComboBox>
                                        </StackPanel>
                                        <StackPanel Width="120">
                                            <TextBlock Text="Voltas"/>
                                            <TextBox x:Name="EventLapsBox" Text="1" Padding="6" Margin="0,3,0,8"/>
                                        </StackPanel>
                                    </WrapPanel>
                                    <TextBlock Text="Música (ID opcional)"/>
                                    <TextBox x:Name="EventMusicBox" Padding="6" Margin="0,3,0,8"/>
                                    <TextBlock Text="HUD layout (ID opcional)"/>
                                    <TextBox x:Name="EventHudBox" Padding="6" Margin="0,3,0,10"/>
                                    <Button Content="Salvar evento" Width="150" HorizontalAlignment="Left" Click="CreateEvent_Click"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Evento Especial" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="ID"/>
                                    <TextBox x:Name="SpecialEventIdBox" Text="local.special-event.new" Padding="6" Margin="0,3,0,8"/>
                                    <TextBlock Text="Nome"/>
                                    <TextBox x:Name="SpecialEventNameBox" Text="New Special Event" Padding="6" Margin="0,3,0,8"/>
                                    <TextBlock Text="Disponibilidade"/>
                                    <ComboBox x:Name="SpecialAvailabilityBox" SelectedIndex="0" Margin="0,3,0,8">
                                        <ComboBoxItem Content="permanent"/>
                                        <ComboBoxItem Content="daily-rotation"/>
                                        <ComboBoxItem Content="weekly-rotation"/>
                                        <ComboBoxItem Content="monthly-rotation"/>
                                        <ComboBoxItem Content="manual"/>
                                        <ComboBoxItem Content="unlock-based"/>
                                    </ComboBox>
                                    <TextBlock Text="Estágios — um Event ID por linha"/>
                                    <TextBox x:Name="SpecialStagesBox" AcceptsReturn="True" Height="90" VerticalScrollBarVisibility="Auto" Padding="6" Margin="0,3,0,10"/>
                                    <Button Content="Salvar Evento Especial" Width="190" HorizontalAlignment="Left" Click="CreateSpecialEvent_Click"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Temporada da Carreira" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="ID"/>
                                    <TextBox x:Name="SeasonIdBox" Text="local.career.new-season" Padding="6" Margin="0,3,0,8"/>
                                    <TextBlock Text="Nome"/>
                                    <TextBox x:Name="SeasonNameBox" Text="New Season" Padding="6" Margin="0,3,0,8"/>
                                    <TextBlock Text="Modo de inserção"/>
                                    <ComboBox x:Name="SeasonInsertModeBox" SelectedIndex="0" Margin="0,3,0,8">
                                        <ComboBoxItem Content="new-season"/>
                                        <ComboBoxItem Content="append-to-season"/>
                                        <ComboBoxItem Content="branch"/>
                                    </ComboBox>
                                    <TextBlock Text="Temporada original alvo (opcional)"/>
                                    <TextBox x:Name="SeasonTargetBox" Padding="6" Margin="0,3,0,8"/>
                                    <TextBlock Text="Corridas — um Event ID por linha"/>
                                    <TextBox x:Name="SeasonEventsBox" AcceptsReturn="True" Height="100" VerticalScrollBarVisibility="Auto" Padding="6" Margin="0,3,0,10"/>
                                    <Button Content="Salvar temporada" Width="160" HorizontalAlignment="Left" Click="CreateSeason_Click"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Conteúdo rápido" Padding="12">
                                <WrapPanel>
                                    <Button Content="Criar template de pista" Click="CreateTrack_Click"/>
                                    <Button Content="Criar template de pintura/livery" Click="CreateLivery_Click"/>
                                </WrapPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Race HUD">
                    <Grid Background="{StaticResource EditorBackground}" Margin="14">
                        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <DockPanel>
                            <TextBlock Text="RACE UI / HUD EDITOR" FontSize="22" FontWeight="Bold"/>
                            <Button DockPanel.Dock="Right" Content="Salvar layout HUD" Click="CreateHud_Click"/>
                        </DockPanel>
                        <Canvas Grid.Row="1" x:Name="HudCanvas" Background="#101419" Margin="0,14,0,0">
                            <Border x:Name="HudPositionElement" Canvas.Left="24" Canvas.Top="24" Padding="10,6" Background="#55303030" BorderBrush="White" BorderThickness="1"
                                    Cursor="SizeAll" MouseLeftButtonDown="HudElement_MouseLeftButtonDown" MouseMove="HudElement_MouseMove" MouseLeftButtonUp="HudElement_MouseLeftButtonUp">
                                <TextBlock Text="POSIÇÃO 1/8" Foreground="White" FontWeight="Bold"/>
                            </Border>
                            <Border x:Name="HudSpeedElement" Canvas.Left="720" Canvas.Top="410" Padding="12,8" Background="#55303030" BorderBrush="White" BorderThickness="1"
                                    Cursor="SizeAll" MouseLeftButtonDown="HudElement_MouseLeftButtonDown" MouseMove="HudElement_MouseMove" MouseLeftButtonUp="HudElement_MouseLeftButtonUp">
                                <TextBlock Text="178 km/h" Foreground="White" FontSize="22" FontWeight="Bold"/>
                            </Border>
                            <Border x:Name="HudNitroElement" Canvas.Left="330" Canvas.Top="430" Padding="12,8" Background="#55303030" BorderBrush="White" BorderThickness="1"
                                    Cursor="SizeAll" MouseLeftButtonDown="HudElement_MouseLeftButtonDown" MouseMove="HudElement_MouseMove" MouseLeftButtonUp="HudElement_MouseLeftButtonUp">
                                <TextBlock Text="NITRO ███████░░" Foreground="White" FontWeight="Bold"/>
                            </Border>
                        </Canvas>
                    </Grid>
                </TabItem>

                <TabItem Header="Replay / Foto / Gráficos">
                    <ScrollViewer Background="{StaticResource EditorBackground}">
                        <StackPanel Margin="20" MaxWidth="850" HorizontalAlignment="Left">
                            <TextBlock Text="REPLAY / PHOTO / GRAPHICS AUTHORING" FontSize="22" FontWeight="Bold" Margin="0,0,0,14"/>
                            <TextBlock TextWrapping="Wrap" Foreground="{StaticResource EditorMuted}" Margin="0,0,0,16"
                                       Text="Estes arquivos descrevem recursos para o Mod Runtime. O editor permanece somente no ReXtremeSDK.exe; nada desta interface é embutido no jogo."/>

                            <GroupBox Header="Replay Mode" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Cria um preset com timeline, velocidades, frame-step, marcadores, troca de alvo e câmeras livres/cinematográficas." TextWrapping="Wrap"/>
                                    <Button Content="Criar preset de Replay" Width="190" HorizontalAlignment="Left" Margin="0,10,0,0" Click="CreateReplayPreset_Click"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Photo Mode" Padding="12" Margin="0,0,0,14">
                                <StackPanel>
                                    <TextBlock Text="Cria um preset utilizável no pause da corrida e no replay pausado. Efeitos do renderer ficam vazios até serem confirmados na engine original." TextWrapping="Wrap"/>
                                    <Button Content="Criar preset de Photo Mode" Width="220" HorizontalAlignment="Left" Margin="0,10,0,0" Click="CreatePhotoPreset_Click"/>
                                </StackPanel>
                            </GroupBox>

                            <GroupBox Header="Configurações Gráficas" Padding="12">
                                <StackPanel>
                                    <TextBlock Text="Cria um catálogo vazio de capacidades. Opções só podem ser preenchidas depois da auditoria do renderer original; o SDK não inventa efeitos." TextWrapping="Wrap"/>
                                    <Button Content="Criar preset gráfico auditável" Width="220" HorizontalAlignment="Left" Margin="0,10,0,0" Click="CreateGraphicsPreset_Click"/>
                                </StackPanel>
                            </GroupBox>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>

                <TabItem Header="Música">
                    <ScrollViewer Background="{StaticResource EditorBackground}">
                        <StackPanel Margin="20" MaxWidth="850" HorizontalAlignment="Left">
                            <TextBlock Text="MUSIC LIBRARY" FontSize="22" FontWeight="Bold"/>
                            <TextBlock Text="ID da faixa" Margin="0,14,0,0"/>
                            <TextBox x:Name="MusicIdBox" Text="local.music.new-track" Padding="6" Margin="0,3,0,8"/>
                            <TextBlock Text="Título"/>
                            <TextBox x:Name="MusicTitleBox" Text="New Track" Padding="6" Margin="0,3,0,8"/>
                            <TextBlock Text="Artista"/>
                            <TextBox x:Name="MusicArtistBox" Padding="6" Margin="0,3,0,8"/>
                            <TextBlock Text="Contexto / playlist"/>
                            <ComboBox x:Name="MusicScopeBox" SelectedIndex="4" Margin="0,3,0,10">
                                <ComboBoxItem Content="menu"/>
                                <ComboBoxItem Content="garage"/>
                                <ComboBoxItem Content="career"/>
                                <ComboBoxItem Content="event"/>
                                <ComboBoxItem Content="race"/>
                                <ComboBoxItem Content="results"/>
                                <ComboBoxItem Content="loading"/>
                                <ComboBoxItem Content="playlist"/>
                            </ComboBox>
                            <Button Content="Importar faixa" Width="160" HorizontalAlignment="Left" Margin="0,0,0,10" Click="ImportMusic_Click"/>
                            <ListBox x:Name="MusicList" Height="280" Background="{StaticResource EditorPanel}" Foreground="{StaticResource EditorText}"/>
                            <TextBlock Foreground="{StaticResource EditorMuted}" Margin="0,8,0,0" TextWrapping="Wrap"
                                       Text="Entrada: WAV, FLAC, OGG, MP3, AAC e M4A. O projeto guarda a fonte e o catálogo; o pipeline de conversão final será definido pelo formato de áudio confirmado do runtime original."/>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
            </TabControl>

            <GridSplitter Grid.Column="3" Width="5" HorizontalAlignment="Stretch" Background="{StaticResource EditorBorder}"/>
            <Border Grid.Column="4" Background="{StaticResource EditorPanel}" Padding="10">
                <StackPanel>
                    <TextBlock Text="INSPECTOR" FontWeight="Bold" Margin="0,0,0,10"/>
                    <TextBlock Text="Projeto" Foreground="{StaticResource EditorMuted}"/>
                    <TextBlock x:Name="InspectorProjectName" Text="—" Margin="0,0,0,8"/>
                    <TextBlock Text="ID" Foreground="{StaticResource EditorMuted}"/>
                    <TextBlock x:Name="InspectorProjectId" Text="—" Margin="0,0,0,8"/>
                    <TextBlock Text="Tipo" Foreground="{StaticResource EditorMuted}"/>
                    <TextBlock x:Name="InspectorProjectType" Text="—" Margin="0,0,0,14"/>

                    <TextBlock Text="DEPENDÊNCIAS" FontWeight="Bold" Margin="0,4,0,5"/>
                    <ListBox x:Name="DependenciesList" Height="105" Background="#17191D" Foreground="{StaticResource EditorText}" Margin="0,0,0,6"/>
                    <TextBlock Text="Mod ID" Foreground="{StaticResource EditorMuted}"/>
                    <TextBox x:Name="DependencyIdBox" Padding="5" Margin="0,2,0,5"/>
                    <TextBlock Text="Versão / range" Foreground="{StaticResource EditorMuted}"/>
                    <TextBox x:Name="DependencyVersionBox" Text="*" Padding="5" Margin="0,2,0,5"/>
                    <WrapPanel Margin="0,0,0,10">
                        <Button Content="Adicionar" Click="AddDependency_Click"/>
                        <Button Content="Remover selecionada" Click="RemoveDependency_Click"/>
                    </WrapPanel>
                    <Separator/>
                    <TextBlock Text="Arquitetura" FontWeight="Bold" Margin="0,12,0,4"/>
                    <TextBlock TextWrapping="Wrap" Foreground="{StaticResource EditorMuted}"
                               Text="ReXtreme SDK é um executável separado. Ele gera .rxmod; o jogo contém apenas o Mod Runtime."/>
                </StackPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="#0D0F12" BorderBrush="{StaticResource EditorBorder}" BorderThickness="0,1,0,0" Padding="8">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="OUTPUT / VALIDATION" FontWeight="Bold" Margin="0,0,0,5"/>
                <TextBox x:Name="OutputBox" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"
                         Background="#0D0F12" Foreground="#D4D8DE" BorderThickness="0" FontFamily="Consolas"/>
            </DockPanel>
        </Border>
        <Border Grid.Row="3" Background="{StaticResource EditorPanel}" Padding="6,3">
            <TextBlock x:Name="StatusText" Text="ReXtreme SDK standalone foundation"/>
        </Border>
    </Grid>
</Window>
