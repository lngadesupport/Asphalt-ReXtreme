<Application x:Class="ReXtremeSDK.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="EditorBackground" Color="#17191D"/>
        <SolidColorBrush x:Key="EditorPanel" Color="#22252B"/>
        <SolidColorBrush x:Key="EditorPanel2" Color="#2B2F36"/>
        <SolidColorBrush x:Key="EditorBorder" Color="#3A3F48"/>
        <SolidColorBrush x:Key="EditorText" Color="#F2F3F5"/>
        <SolidColorBrush x:Key="EditorMuted" Color="#AEB4BE"/>
        <Style TargetType="Window">
            <Setter Property="Background" Value="{StaticResource EditorBackground}"/>
            <Setter Property="Foreground" Value="{StaticResource EditorText}"/>
            <Setter Property="FontFamily" Value="Segoe UI"/>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource EditorPanel2}"/>
            <Setter Property="Foreground" Value="{StaticResource EditorText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource EditorBorder}"/>
            <Setter Property="Padding" Value="10,6"/>
            <Setter Property="Margin" Value="2"/>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Background" Value="#15171A"/>
            <Setter Property="Foreground" Value="{StaticResource EditorText}"/>
            <Setter Property="BorderBrush" Value="{StaticResource EditorBorder}"/>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="{StaticResource EditorPanel2}"/>
            <Setter Property="Foreground" Value="Black"/>
        </Style>
    </Application.Resources>
</Application>
